{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunConfig",
  "description": "Written by writing-coordinator Step 1 before any agents are spawned. Path: files/run-config.json",
  "owner": "writing-coordinator",
  "type": "object",
  "required": ["topic", "languages", "wordCountTarget", "wordCountRange"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": ["string", "null"], "format": "uri" },
    "urlIntent": { "type": ["string", "null"], "enum": ["commentary", "own_version", null] },
    "languages": {
      "type": "array",
      "items": { "type": "string", "enum": ["en", "tr"] },
      "minItems": 1,
      "maxItems": 2
    },
    "format": { "type": ["string", "null"], "enum": ["explainer", "how-to", "listicle", "opinion", "case-study", null] },
    "tone": { "type": ["string", "null"] },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "wordCountTarget": { "type": "string", "enum": ["short", "standard", "long"] },
    "wordCountRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "pauseAfterOutline": { "type": "boolean" },
    "skipAltFormat": { "type": "boolean" },
    "seoBrief": { "type": "boolean" }
  }
}
