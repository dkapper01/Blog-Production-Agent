{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchFile",
  "description": "Written by researcher subagents. Path: files/research/{slug}.json. Coordinator validates keyFindings.length >= 3 before proceeding.",
  "owner": "researcher (leaf agent)",
  "type": "object",
  "required": ["slug", "subtopic", "summary", "keyFindings", "sources"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "subtopic": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "keyFindings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "targetFacts": { "type": "array", "items": { "type": "string" } },
    "usefulQuotes": { "type": "array", "items": { "type": "string" } },
    "dataGaps": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
